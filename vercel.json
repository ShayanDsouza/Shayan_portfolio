{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "js/**",      "use": "@vercel/static" },
    { "src": "styles/**",  "use": "@vercel/static" },
    { "src": "login/**",   "use": "@vercel/static" },
    { "src": "cms/**",     "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1"          },
    { "src": "/login",    "dest": "/login/index.html" },
    { "src": "/cms",      "dest": "/cms/index.html"   },
    { "src": "/(.*)",     "dest": "/$1"               }
  ]
}
