{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "login/index.html", "use": "@vercel/static" },
    { "src": "cms/index.html", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "styles/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/login", "dest": "/login/index.html" },
    { "src": "/cms",   "dest": "/cms/index.html"   },
    { "src": "/(.*)",  "dest": "/$1"               }
  ]
}
